Project RideShareHub {
  database_type: 'PostgreSQL'
  Note: 'V1 core schema. Notification, passenger-profile and detailed report workflows are deferred.'
}

Enum user_role { PASSENGER TRANSPORT_COMPANY DRIVER ADMIN }
Enum user_status { ACTIVE LOCKED }
Enum company_status { PENDING APPROVED REJECTED }
Enum vehicle_status { AVAILABLE IN_USE MAINTENANCE INACTIVE }
Enum driver_status { ACTIVE INACTIVE SUSPENDED }
Enum route_status { ACTIVE INACTIVE }
Enum trip_status { DRAFT PUBLISHED FULL IN_PROGRESS COMPLETED CANCELLED }
Enum driver_assignment_status { ASSIGNED ACCEPTED READY }
Enum booking_status { PENDING CONFIRMED PICKED_UP COMPLETED CANCELLED NO_SHOW }
Enum stop_type { PICKUP DROPOFF }
Enum stop_status { PENDING ARRIVED COMPLETED }
Enum proposal_status { PROPOSED ACCEPTED REJECTED SUPERSEDED }

Table users {
  id bigint [pk, increment]
  email varchar(255) [unique, not null]
  phone varchar(20) [unique]
  password_hash varchar(255) [not null]
  full_name varchar(150) [not null]
  role user_role [not null]
  status user_status [not null, default: 'ACTIVE']
  avatar_url varchar(500)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { role status }
}

Table transport_companies {
  id bigint [pk, increment]
  owner_user_id bigint [unique, not null, ref: - users.id]
  name varchar(200) [not null]
  business_license_no varchar(50) [unique]
  tax_code varchar(30)
  address varchar(500) [not null]
  contact_phone varchar(20) [not null]
  contact_email varchar(255)
  representative_name varchar(150) [not null]
  business_information text [not null]
  description text
  logo_url varchar(500)
  status company_status [not null, default: 'PENDING']
  approved_by bigint [ref: > users.id]
  approved_at timestamptz
  reject_reason varchar(500)
  avg_rating decimal(3,2) [not null, default: 0]
  rating_count int [not null, default: 0]
  version bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { status }
}

Table drivers {
  id bigint [pk, increment]
  user_id bigint [unique, not null, ref: - users.id]
  company_id bigint [not null, ref: > transport_companies.id]
  license_number varchar(50) [not null]
  license_class varchar(10)
  license_expiry date
  status driver_status [not null, default: 'ACTIVE']
  is_available boolean [not null, default: true]
  avg_rating decimal(3,2) [not null, default: 0]
  rating_count int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { company_id (company_id, license_number) [unique] }
}

Table vehicles {
  id bigint [pk, increment]
  company_id bigint [not null, ref: > transport_companies.id]
  plate_number varchar(20) [unique, not null]
  vehicle_type varchar(50) [not null]
  brand varchar(50)
  model varchar(50)
  seat_capacity int [not null, note: 'CHECK seat_capacity > 0']
  description text
  image_url varchar(500)
  status vehicle_status [not null, default: 'AVAILABLE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { company_id status }
}

Table routes {
  id bigint [pk, increment]
  company_id bigint [not null, ref: > transport_companies.id]
  name varchar(200) [not null]
  origin_name varchar(200) [not null]
  origin_lat decimal(10,7)
  origin_lng decimal(10,7)
  destination_name varchar(200) [not null]
  destination_lat decimal(10,7)
  destination_lng decimal(10,7)
  estimated_distance_m int
  estimated_duration_min int
  base_price decimal(12,2)
  description text
  status route_status [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { company_id (origin_name, destination_name) }
}

Table trips {
  id bigint [pk, increment]
  route_id bigint [not null, ref: > routes.id]
  company_id bigint [not null, ref: > transport_companies.id]
  vehicle_id bigint [ref: > vehicles.id]
  driver_id bigint [ref: > drivers.id]
  driver_assignment_status driver_assignment_status [default: 'ASSIGNED']
  departure_time timestamptz [not null]
  estimated_arrival_time timestamptz
  price_per_seat decimal(12,2) [not null]
  total_seats int [not null, note: 'CHECK total_seats > 0']
  booked_seats int [not null, default: 0, note: 'CHECK booked_seats BETWEEN 0 AND total_seats']
  version bigint [not null, default: 0]
  status trip_status [not null, default: 'DRAFT']
  cancel_reason varchar(500)
  published_at timestamptz
  started_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { (route_id, departure_time) (company_id, status) (status, departure_time) (vehicle_id, departure_time) (driver_id, departure_time) }
  Note: 'Overlap protection requires a non-null operational interval before publish.'
}

Table bookings {
  id bigint [pk, increment]
  booking_code varchar(20) [unique, not null]
  trip_id bigint [not null, ref: > trips.id]
  passenger_id bigint [not null, ref: > users.id]
  idempotency_key varchar(100) [not null]
  seat_count int [not null, note: 'CHECK seat_count > 0']
  pickup_address varchar(500) [not null]
  pickup_lat decimal(10,7) [not null]
  pickup_lng decimal(10,7) [not null]
  dropoff_address varchar(500) [not null]
  dropoff_lat decimal(10,7) [not null]
  dropoff_lng decimal(10,7) [not null]
  estimated_fare decimal(12,2) [not null]
  status booking_status [not null, default: 'PENDING']
  cancel_reason varchar(500)
  cancelled_at timestamptz
  confirmed_at timestamptz
  picked_up_at timestamptz
  completed_at timestamptz
  version bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { trip_id (passenger_id, idempotency_key) [unique] (passenger_id, status) (trip_id, status) }
  Note: 'Seat-holding statuses depend on the still-open Booking confirmation policy.'
}

Table trip_stops {
  id bigint [pk, increment]
  trip_id bigint [not null, ref: > trips.id]
  booking_id bigint [not null, ref: > bookings.id]
  stop_type stop_type [not null]
  address varchar(500) [not null]
  lat decimal(10,7) [not null]
  lng decimal(10,7) [not null]
  seat_delta int [not null]
  status stop_status [not null, default: 'PENDING']
  arrived_at timestamptz
  completed_at timestamptz
  version bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes { (booking_id, stop_type) [unique] (trip_id, status) }
  Note: 'Exactly one pickup and one dropoff per Booking; pickup completion precedes dropoff completion.'
}

Table route_proposals {
  id bigint [pk, increment]
  trip_id bigint [not null, ref: > trips.id]
  status proposal_status [not null, default: 'PROPOSED']
  estimated_distance_m int
  estimated_duration_s int
  optimized_cost decimal(14,4)
  source varchar(50) [not null, default: 'OPTIMIZER']
  reviewed_by bigint [ref: > users.id]
  reviewed_at timestamptz
  review_note varchar(500)
  version bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  indexes { (trip_id, status) }
  Note: 'Proposal alone never changes Trip or Booking business state.'
}

Table route_proposal_stops {
  proposal_id bigint [not null, ref: > route_proposals.id]
  trip_stop_id bigint [not null, ref: > trip_stops.id]
  sequence_no int [not null, note: 'CHECK sequence_no >= 0']
  planned_eta timestamptz
  indexes { (proposal_id, trip_stop_id) [pk] (proposal_id, sequence_no) [unique] }
}

Table driver_locations {
  id bigint [pk, increment]
  trip_id bigint [not null, ref: > trips.id]
  driver_id bigint [not null, ref: > drivers.id]
  lat decimal(10,7) [not null]
  lng decimal(10,7) [not null]
  speed_kmh decimal(5,2)
  heading decimal(5,2)
  recorded_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  indexes { (trip_id, recorded_at) (driver_id, recorded_at) }
  Note: 'Retention remains an open product/privacy decision.'
}

Table ratings {
  id bigint [pk, increment]
  booking_id bigint [unique, not null, ref: - bookings.id]
  trip_id bigint [not null, ref: > trips.id]
  passenger_id bigint [not null, ref: > users.id]
  driver_id bigint [ref: > drivers.id]
  company_id bigint [ref: > transport_companies.id]
  driver_score smallint
  company_score smallint
  comment text
  created_at timestamptz [not null, default: `now()`]
  Note: 'Scale/check constraints remain open until the rating policy is accepted.'
}
